# ---- Required ----
# PostgreSQL connection string (Vercel Postgres / Neon / Supabase / any host)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Long random string that signs login tokens (e.g. run: openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-string

# ---- Recommended ----
# Whoever registers with this email becomes the admin / fraud analyst
ADMIN_EMAIL=admin@example.com
# Lets Vercel Cron pay daily savings interest (any long random string)
CRON_SECRET=replace-with-another-long-random-string

# ---- Optional ----
CURRENCY=USD
DAILY_LIMIT=100000
SAVINGS_APY=3.0
